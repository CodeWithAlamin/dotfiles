#!/usr/bin/env bash
set -euo pipefail

echo '========================================'
echo ' CachyOS Application Setup'
echo '========================================'
echo

sudo pacman -Syu --needed

sudo pacman -S --needed \
    nodejs npm thunar gedit gthumb kitty unzip fastfetch zsh \
    zsh-autosuggestions zsh-syntax-highlighting git base-devel nwg-look

if ! command -v yay >/dev/null 2>&1; then
    TEMP_DIR="$(mktemp -d)"
    git clone https://aur.archlinux.org/yay.git "$TEMP_DIR/yay"
    cd "$TEMP_DIR/yay"
    makepkg -si --noconfirm
    cd - >/dev/null
    rm -rf "$TEMP_DIR"
fi

yay -S --needed visual-studio-code-bin vivaldi jopdf adw-gtk3

P10K_DIR="$HOME/powerlevel10k"
if [ -d "$P10K_DIR/.git" ]; then
    git -C "$P10K_DIR" pull --ff-only
else
    rm -rf "$P10K_DIR"
    git clone --depth=1 https://github.com/romkatv/powerlevel10k.git "$P10K_DIR"
fi

touch "$HOME/.zshrc"
add_line_if_missing() {
    local line="$1"
    grep -Fqx "$line" "$HOME/.zshrc" || printf '%s\n' "$line" >> "$HOME/.zshrc"
}
add_line_if_missing '# Powerlevel10k'
add_line_if_missing 'source "$HOME/powerlevel10k/powerlevel10k.zsh-theme"'
add_line_if_missing '# Zsh autosuggestions'
add_line_if_missing 'source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh'
add_line_if_missing '# Zsh syntax highlighting'
add_line_if_missing 'source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh'
add_line_if_missing '# Fastfetch'
add_line_if_missing 'fastfetch'

mkdir -p "$HOME/.config/gtk-3.0"
if [ -f "$HOME/.config/gtk-3.0/settings.ini" ]; then
    if grep -q '^gtk-theme-name=' "$HOME/.config/gtk-3.0/settings.ini"; then
        sed -i 's/^gtk-theme-name=.*/gtk-theme-name=adw-gtk3-dark/' "$HOME/.config/gtk-3.0/settings.ini"
    else
        printf '%s\n' 'gtk-theme-name=adw-gtk3-dark' >> "$HOME/.config/gtk-3.0/settings.ini"
    fi
else
    printf '%s\n' '[Settings]' 'gtk-theme-name=adw-gtk3-dark' > "$HOME/.config/gtk-3.0/settings.ini"
fi

echo
echo '========================================'
echo ' Additional packages'
echo '========================================'
echo 'Enter package names separated by spaces, or press Enter to skip.'
read -r -a EXTRA_PACKAGES
if [ "${#EXTRA_PACKAGES[@]}" -gt 0 ]; then
    yay -S --needed "${EXTRA_PACKAGES[@]}"
fi

echo
echo '>>> Changing default shell to Zsh (last step)...'
ZSH_PATH=/usr/bin/zsh
if [ "$SHELL" != "$ZSH_PATH" ]; then
    chsh -s "$ZSH_PATH"
fi

echo
echo '========================================'
echo ' Installation complete!'
echo '========================================'
echo "Run 'p10k configure' in a new Zsh session."
echo 'Log out and back in for the shell change to take effect.'